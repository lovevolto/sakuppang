  const musicAudio = new Audio();
  musicAudio.preload = 'metadata';
  musicAudio.setAttribute('playsinline', '');
  let musicIdx = -1, musicShuffle = false, musicRepeat = 'off', musicNPOpen = false, musicSeeking = false;

  const svg = (d, extra) => '<svg viewBox="0 0 24 24" ' + (extra || 'fill="currentColor"') + '>' + d + '</svg>';
  const stroke = 'fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"';
  const mi = {
    play: svg('<path d="M8 5.5v13a1 1 0 0 0 1.5.86l10.5-6.5a1 1 0 0 0 0-1.72L9.5 4.64A1 1 0 0 0 8 5.5z"/>'),
    pause: svg('<rect x="6" y="5" width="4.2" height="14" rx="1.2"/><rect x="13.8" y="5" width="4.2" height="14" rx="1.2"/>'),
    next: svg('<path d="M4.5 6.3v11.4a.9.9 0 0 0 1.4.75l8-5.7a.9.9 0 0 0 0-1.5l-8-5.7a.9.9 0 0 0-1.4.75zM16 5.5h2.4v13H16z"/>'),
    prev: svg('<path d="M19.5 6.3v11.4a.9.9 0 0 1-1.4.75l-8-5.7a.9.9 0 0 1 0-1.5l8-5.7a.9.9 0 0 1 1.4.75zM8 5.5H5.6v13H8z"/>'),
    shuffle: svg('<path d="M3 7h3.5c5 0 5 10 10 10H21M3 17h3.5c1.6 0 2.8-.7 3.7-1.8M14 8.8C14.9 7.7 15.6 7 17 7h4M18 4l3 3-3 3M18 14l3 3-3 3"/>', stroke),
    repeat: svg('<path d="M17 3l3 3-3 3M4 11V9.5A3.5 3.5 0 0 1 7.5 6H20M7 21l-3-3 3-3M20 13v1.5a3.5 3.5 0 0 1-3.5 3.5H4"/>', stroke),
    note: svg('<path d="M9 17.5V6.8c0-.5.4-1 .9-1.1l8-1.6c.6-.1 1.1.3 1.1.9v10.5a2.5 2.5 0 1 1-1.5-2.3V7.4L10.5 8.7v9.9A2.5 2.5 0 1 1 9 17.5z"/>')
  };

  const esc = t => String(t).replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
  const fmtTime = t => { t = Math.max(0, Math.floor(t || 0)); return Math.floor(t / 60) + ':' + String(t % 60).padStart(2, '0'); };
  const musicHue = i => [350, 265, 200, 28, 150][i % 5];

  function musicArt(i, px) {
    const t = musicTracks[i];
    const base = 'width:' + px + 'px;height:' + px + 'px;';
    if (t.cover) return '<div class="music-art" style="' + base + '"><img src="' + esc(t.cover) + '" style="width:100%;height:100%;object-fit:cover"></div>';
    const h = musicHue(i);
    return '<div class="music-art" style="' + base + 'background:linear-gradient(135deg,hsl(' + h + ',70%,62%),hsl(' + ((h + 35) % 360) + ',70%,42%))">' +
      '<span style="display:block;width:' + Math.round(px * 0.45) + 'px;height:' + Math.round(px * 0.45) + 'px">' + mi.note + '</span></div>';
  }

  function musicToast(msg) {
    const el = document.createElement('div');
    el.className = 'music-toast';
    el.textContent = msg;
    document.querySelector('.phone').appendChild(el);
    setTimeout(() => el.remove(), 2600);
  }

  function renderMusic(animateNP) {
    const body = document.getElementById('app-body');
    const prev = body.querySelector('.music-scroll');
    const prevScroll = prev ? prev.scrollTop : 0;
    const playing = musicIdx >= 0 && !musicAudio.paused;
    const cur = musicIdx >= 0 ? musicTracks[musicIdx] : null;

    const rows = musicTracks.map((t, i) =>
      '<div class="music-row' + (i === musicIdx ? ' current' : '') + '" onclick="musicRowTap(' + i + ')">' +
        musicArt(i, 48) +
        '<div class="music-meta"><div class="music-name">' + esc(t.title) + '</div><div class="music-artist">' + esc(t.artist) + '</div></div>' +
        (i === musicIdx && playing ? '<div class="eq"><i></i><i></i><i></i></div>' : '') +
      '</div>').join('');

    const mini = cur
      ? '<div class="music-mini" onclick="musicOpenNP()">' + musicArt(musicIdx, 42) +
          '<div class="music-meta"><div class="music-name">' + esc(cur.title) + '</div></div>' +
          '<button onclick="event.stopPropagation();musicToggle()">' + (playing ? mi.pause : mi.play) + '</button>' +
          '<button onclick="event.stopPropagation();musicNext(false)">' + mi.next + '</button>' +
        '</div>' : '';

    const sheet = cur
      ? '<div class="np-sheet" id="np-sheet" style="background:linear-gradient(180deg,hsl(' + musicHue(musicIdx) + ',45%,38%) 0%,#111 100%)">' +
          '<div class="np-grab" onclick="musicCloseNP()"></div>' +
          '<div class="np-art' + (playing ? '' : ' paused') + '">' + musicArt(musicIdx, 252) + '</div>' +
          '<div class="np-info"><div class="np-title">' + esc(cur.title) + '</div><div class="np-artist">' + esc(cur.artist) + '</div>' +
          '<input type="range" class="np-seek" id="mp-seek" min="0" max="1" step="0.01" value="0" oninput="musicSeekTo(this.value)" onchange="musicSeeking=false">' +
          '<div class="np-times"><span id="mp-cur">0:00</span><span id="mp-rem">-0:00</span></div></div>' +
          '<div class="np-ctrl"><button onclick="musicPrev()">' + mi.prev + '</button>' +
          '<button class="np-main" onclick="musicToggle()">' + (playing ? mi.pause : mi.play) + '</button>' +
          '<button onclick="musicNext(false)">' + mi.next + '</button></div>' +
          '<div class="np-sub"><button class="' + (musicShuffle ? 'on' : '') + '" onclick="musicToggleShuffle()">' + mi.shuffle + '</button>' +
          '<button class="' + (musicRepeat !== 'off' ? 'on' : '') + '" onclick="musicCycleRepeat()">' + mi.repeat + (musicRepeat === 'one' ? '<b>1</b>' : '') + '</button></div>' +
        '</div>' : '';

    body.innerHTML =
      '<div class="music-app">' +
        '<div class="music-top"><button class="gl back" style="color:#fa2d48" onclick="showScreen(\'home-screen\')"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 5.5 8 12l6.5 6.5"/></svg><span>Home</span></button>' +
        '<button class="music-link" style="font-size:28px;font-weight:300;line-height:1" onclick="document.getElementById(\'music-file\').click()">+</button></div>' +
        '<div class="music-title">Songs</div>' +
        '<div class="music-scroll" style="padding-bottom:' + (cur ? 96 : 40) + 'px">' +
          '<div class="music-actions">' +
            '<button class="music-btn" onclick="musicPlayAll(false)">' + mi.play + 'Play</button>' +
            '<button class="music-btn" onclick="musicPlayAll(true)">' + mi.shuffle + 'Shuffle</button></div>' +
          rows + '<div class="music-count">' + musicTracks.length + ' songs</div>' +
        '</div>' +
        '<div style="position:absolute;left:0;right:0;bottom:0">' + mini + '</div>' +
        '<input type="file" id="music-file" accept="audio/*" multiple hidden onchange="musicAddFiles(this.files)">' +
        sheet +
      '</div>';

    const sc = body.querySelector('.music-scroll');
    if (sc) sc.scrollTop = prevScroll;
    const sh = document.getElementById('np-sheet');
    if (sh) {
      if (musicNPOpen && animateNP) requestAnimationFrame(() => requestAnimationFrame(() => sh.classList.add('open')));
      else if (musicNPOpen) sh.classList.add('open');
    }
    document.getElementById('app-screen').classList.toggle('dark', musicNPOpen && !!cur);
    musicProgress();
  }

  function musicRefresh() { if (document.querySelector('.music-app')) renderMusic(); }

  function musicProgress() {
    const seek = document.getElementById('mp-seek');
    if (!seek) return;
    const d = musicAudio.duration || 0, c = musicAudio.currentTime || 0;
    if (!musicSeeking) { seek.max = d || 1; seek.value = c; }
    seek.style.setProperty('--p', (d ? (c / d) * 100 : 0) + '%');
    document.getElementById('mp-cur').textContent = fmtTime(c);
    document.getElementById('mp-rem').textContent = '-' + fmtTime(d - c);
    if (d && 'mediaSession' in navigator && navigator.mediaSession.setPositionState) {
      try { navigator.mediaSession.setPositionState({ duration: d, position: Math.min(c, d), playbackRate: 1 }); } catch (e) {}
    }
  }

  function musicSeekTo(v) {
    musicSeeking = true;
    musicAudio.currentTime = parseFloat(v);
    musicProgress();
  }

  function musicSetMedia() {
    if (!('mediaSession' in navigator) || musicIdx < 0) return;
    const t = musicTracks[musicIdx];
    navigator.mediaSession.metadata = new MediaMetadata({
      title: t.title, artist: t.artist, album: t.album || '',
      artwork: t.cover ? [{ src: t.cover }] : []
    });
  }

  function musicPlay(i) {
    if (i < 0 || i >= musicTracks.length) return;
    musicIdx = i;
    musicAudio.src = musicTracks[i].src;
    const pr = musicAudio.play();
    if (pr && pr.catch) pr.catch(e => { if (e.name === 'NotAllowedError') musicToast('แตะปุ่มเล่นอีกครั้ง'); });
    musicSetMedia();
    musicRefresh();
  }

  function musicRowTap(i) { i === musicIdx ? musicToggle() : musicPlay(i); }

  function musicToggle() {
    if (musicIdx < 0) return musicPlay(0);
    if (musicAudio.paused) { const pr = musicAudio.play(); if (pr && pr.catch) pr.catch(() => {}); }
    else musicAudio.pause();
  }

  function musicPlayAll(shuffle) {
    musicShuffle = shuffle;
    musicPlay(shuffle ? Math.floor(Math.random() * musicTracks.length) : 0);
  }

  function musicNext(auto) {
    const n = musicTracks.length;
    if (!n) return;
    if (auto && musicRepeat === 'one') { musicAudio.currentTime = 0; musicAudio.play(); return; }
    let i;
    if (musicShuffle && n > 1) { do { i = Math.floor(Math.random() * n); } while (i === musicIdx); }
    else {
      i = musicIdx + 1;
      if (i >= n) {
        if (auto && musicRepeat === 'off') { musicAudio.pause(); musicAudio.currentTime = 0; musicRefresh(); return; }
        i = 0;
      }
    }
    musicPlay(i);
  }

  function musicPrev() {
    if (musicAudio.currentTime > 3) { musicAudio.currentTime = 0; return; }
    musicPlay((musicIdx - 1 + musicTracks.length) % musicTracks.length);
  }

  function musicToggleShuffle() { musicShuffle = !musicShuffle; renderMusic(); }
  function musicCycleRepeat() { musicRepeat = { off: 'all', all: 'one', one: 'off' }[musicRepeat]; renderMusic(); }
  function musicOpenNP() { if (musicIdx < 0) return; musicNPOpen = true; renderMusic(true); }
  function musicCloseNP() {
    const sh = document.getElementById('np-sheet');
    musicNPOpen = false;
    document.getElementById('app-screen').classList.remove('dark');
    if (sh) { sh.classList.remove('open'); setTimeout(renderMusic, 420); } else renderMusic();
  }

  function musicAddFiles(files) {
    Array.from(files).forEach(f => musicTracks.push({
      title: f.name.replace(/\.[^.]+$/, ''), artist: 'ไฟล์ในเครื่อง', src: URL.createObjectURL(f), cover: ''
    }));
    renderMusic();
  }

  musicAudio.addEventListener('play', musicRefresh);
  musicAudio.addEventListener('pause', musicRefresh);
  musicAudio.addEventListener('ended', () => musicNext(true));
  musicAudio.addEventListener('timeupdate', musicProgress);
  musicAudio.addEventListener('loadedmetadata', musicProgress);
  musicAudio.addEventListener('error', () => {
    if (musicIdx >= 0 && musicAudio.getAttribute('src')) musicToast('Music file not found: ' + musicTracks[musicIdx].title);
  });

  if ('mediaSession' in navigator) {
    const ms = navigator.mediaSession;
    ms.setActionHandler('play', () => musicToggle());
    ms.setActionHandler('pause', () => musicToggle());
    ms.setActionHandler('previoustrack', () => musicPrev());
    ms.setActionHandler('nexttrack', () => musicNext(false));
    try { ms.setActionHandler('seekto', d => { musicAudio.currentTime = d.seekTime; }); } catch (e) {}
  }

