    if (touchStartY - e.changedTouches[0].clientY > 50) showScreen('passcode-screen');
  }, { passive: true });

  const keysData = [
    { n: '1', l: '' }, { n: '2', l: 'ABC' }, { n: '3', l: 'DEF' },
    { n: '4', l: 'GHI' }, { n: '5', l: 'JKL' }, { n: '6', l: 'MNO' },
    { n: '7', l: 'PQRS' }, { n: '8', l: 'TUV' }, { n: '9', l: 'WXYZ' },
    { n: '', l: '' }, { n: '0', l: '' }
  ];

  const keypad = document.getElementById('keypad');
  keysData.forEach(k => {
    if (!k.n) { 
      keypad.appendChild(document.createElement('div')); 
      return; 
    }
    const btn = document.createElement('div');
    btn.className = 'key';

    if (k.n === '⌫') {
      btn.textContent = '⌫';
      btn.onclick = () => {
        currentPasscode = currentPasscode.slice(0, -1);
        updateDots();
      };
    } else {
      btn.innerHTML = `${k.n}${k.l ? `<small>${k.l}</small>` : ''}`;
      btn.onclick = () => {
        if (currentPasscode.length >= 4) return;
        snd('tap');
        currentPasscode += k.n;
        updateDots();
        if (currentPasscode.length === 4) setTimeout(verifyPasscode, 150);
      };
    }
    keypad.appendChild(btn);
  });

  function updateDots() {
    document.querySelectorAll('.dot').forEach((dot, idx) => {
      dot.classList.toggle('filled', idx < currentPasscode.length);
    });
  }

  function verifyPasscode() {
    if (currentPasscode === PASSCODE) {
      snd('unlock');
      showScreen('home-screen');
      currentPasscode = '';
      updateDots();
    } else {
      snd('wrong');
      if (navigator.vibrate) navigator.vibrate([60, 40, 60]);
      const screen = document.getElementById('passcode-screen');
      screen.style.animation = 'shake 0.4s ease';
      setTimeout(() => {
        screen.style.animation = '';
        currentPasscode = '';
        updateDots();
      }, 400);
    }
  }

