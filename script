  /* =============== CALENDAR =============== */
  const TH_M = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
  const TH_D = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
  const TH_D_SHORT = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
  /* วันเกิดริคุ 28 มิ.ย. ทุกปี: 2023 = "วันเกิดริคุ", 2024 เป็นต้นไป = "วันเกิดเจ้าหญิง" (ไปได้ไม่จำกัดปี) */
  const calEventsFor = (y, m, d) => {
    if (m !== 7 || d !== 4 || y < 2023) return null;
     const note = y === 2026 ? 'midnight birthday call' : 'ริคุอายุ ' + (y - 2007) + ' ปี';
    return [{ time: 'all-day', title: (y === 2023 ? 'ryo' : 'ryochan\'s day') + ' 🎂', note: note }];
  };
  const cal = { y: 2026, m: 7, sel: 4 };
  const keyOf = (y, m, d) => y + '-' + (m + 1) + '-' + d;

  function renderCalendar() {
    const now = new Date();
    const first = new Date(cal.y, cal.m, 1).getDay();
    const days = new Date(cal.y, cal.m + 1, 0).getDate();
    const prevDays = new Date(cal.y, cal.m, 0).getDate();
    let cells = '';
    for (let i = first - 1; i >= 0; i--) cells += '<div class="cal-d out"><span>' + (prevDays - i) + '</span><i></i></div>';
    for (let d = 1; d <= days; d++) {
      const isToday = now.getFullYear() === cal.y && now.getMonth() === cal.m && now.getDate() === d;
      const cls = (isToday ? ' today' : '') + (cal.sel === d ? ' sel' : '') + (calEventsFor(cal.y, cal.m, d) ? ' has' : '');
      cells += '<div class="cal-d' + cls + '" onclick="calPick(' + d + ')"><span>' + d + '</span><i></i></div>';
    }
    const total = first + days;
    const trail = (7 - (total % 7)) % 7;
    for (let d = 1; d <= trail; d++) cells += '<div class="cal-d out"><span>' + d + '</span><i></i></div>';

    let dayBlock = '';
    if (cal.sel) {
      const wd = TH_D[new Date(cal.y, cal.m, cal.sel).getDay()];
      const evs = calEventsFor(cal.y, cal.m, cal.sel) || [];
      dayBlock = '<div class="cal-day-h">' + wd + ', ' + TH_M[cal.m] + ' ' + cal.sel + ', ' + cal.y + '</div>' +
  (evs.length
    ? evs.map(e => '<div class="cal-ev"><div class="bar"></div><div><div class="tm">' + E(e.time) + '</div><b>' + E(e.title) + '</b><small>' + E(e.note) + '</small></div></div>').join('')
    : '<div class="cal-empty">No Events</div>');
    }
    const tab = (icon, label, on, fn) => '<div class="ftab' + (on ? ' on' : '') + '"' + (fn ? ' onclick="' + fn + '"' : '') + '>' + icon + '<span>' + label + '</span></div>';
    mount(
      '<div class="ios-app grouped" style="--acc:#ff3b30">' +
        '<div class="ios-top">' + back('Home', HOME) +
          '<div class="gl multi"><span onclick="calNav(-1)" style="display:flex;cursor:pointer">' + IC.chevL + '</span><span onclick="calNav(1)" style="display:flex;cursor:pointer">' + IC.chevR + '</span></div></div>' +
        '<div class="ios-scroll">' +
          '<div class="cal-top-wrap" style="background:#fff;margin-bottom:0;padding-bottom:2px;border-radius:0 0 26px 26px">' +
            '<div class="cal-head"><h1>' + TH_M[cal.m] + '<small>' + cal.y + '</small></h1></div>' +
            '<div class="cal-wd">' + TH_D_SHORT.map(d => '<span>' + d + '</span>').join('') + '</div>' +
            '<div class="cal-grid" style="border-bottom:none">' + cells + '</div>' +
          '</div>' + dayBlock +
        '</div>' +
        '<div class="ftabs">' + tab(IC.calendar, 'Today', false, 'calToday()') + tab(IC.list, 'Calendars', true) + tab(IC.search, 'Search', false) + '</div>' +
      '</div>');
  }
  window.calPick = function (d) { cal.sel = d; renderCalendar(); };
  window.calNav = function (n) {
    cal.m += n;
    if (cal.m < 0) { cal.m = 11; cal.y--; } else if (cal.m > 11) { cal.m = 0; cal.y++; }
    cal.sel = calEventsFor(cal.y, cal.m, 4) ? 4 : null;
    renderCalendar();
  };
  window.calToday = function () {
    const n = new Date();
    cal.y = n.getFullYear(); cal.m = n.getMonth(); cal.sel = n.getDate();
    renderCalendar();
  };

  
