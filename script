/* Status bar global: aparece em todos os apps e muda de cor conforme o fundo da página */
(function () {
  const phone = document.querySelector('.phone');
  const bar = document.getElementById('sys-status');
  if (!phone || !bar) return;
  const OWN_BAR = ['lock-screen', 'passcode-screen', 'home-screen']; // já têm status bar própria

  function parse(c) {
    const m = c.match(/rgba?\(([^)]+)\)/);
    if (!m) return null;
    const p = m[1].split(/[ ,\/]+/).filter(Boolean).map(Number);
    return { r: p[0], g: p[1], b: p[2], a: p.length > 3 ? p[3] : 1 };
  }
  const lum = c => (0.2126 * c.r + 0.7152 * c.g + 0.0722 * c.b) / 255;

  function shouldShow() {
    if (document.querySelector('.chat-detail-screen.active, .kakao-chat-screen.active, .note-detail-screen.active, .photo-viewer.active')) return true;
    const s = document.querySelector('.screen.active');
    return !!s && OWN_BAR.indexOf(s.id) === -1;
  }

  function backdropIsDark() {
    const r = phone.getBoundingClientRect();
    const list = document.elementsFromPoint(r.left + 40, r.top + 22);
    for (const el of list) {
      if (el === bar || bar.contains(el) || el.classList.contains('dynamic-island')) continue;
      const cs = getComputedStyle(el);
      let c = parse(cs.backgroundColor);
      if (c && c.a >= 0.5) return lum(c) < 0.5;
      if (cs.backgroundImage && cs.backgroundImage.indexOf('gradient') > -1) {
        c = parse(cs.backgroundImage);              // primeira cor do gradiente
        if (c && c.a >= 0.5) return lum(c) < 0.5;
      }
    }
    return false;
  }

  let raf = 0;
  function update() {
    raf = 0;
    const show = shouldShow();
    if (bar.classList.contains('show') !== show) bar.classList.toggle('show', show);
    if (!show) return;
    const ink = !backdropIsDark();                   // fundo claro -> texto preto
    if (bar.classList.contains('ink') !== ink) bar.classList.toggle('ink', ink);
  }
  const schedule = () => { if (!raf) raf = requestAnimationFrame(update); };

  new MutationObserver(schedule).observe(phone, { subtree: true, childList: true, attributes: true, attributeFilter: ['class', 'style'] });
  setInterval(update, 500);   // garante a cor correta após transições/animações
  update();
})();


/* Player de música da lockscreen — usa o mesmo áudio do app Music (musicTracks, musicAudio...) */
(function () {
  const box = document.getElementById('lock-music');
  if (!box || typeof musicTracks === 'undefined' || !musicTracks.length) return;
  const AUTOPLAY = true;   // true: a música começa sozinha (ou no primeiro toque, pois o navegador bloqueia som antes disso)
  const star = '<svg viewBox="0 0 24 24" fill="currentColor"><path d="m12 3.8 2.5 5.1 5.6.8-4 4 1 5.6-5.1-2.7-5.1 2.7 1-5.6-4-4 5.6-.8z"/></svg>';
  const air = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M8 15.5a5.5 5.5 0 1 1 8 0"/><path d="M5 18.5a9.5 9.5 0 1 1 14 0" opacity=".55"/><path d="m12 15 4 5H8z" fill="currentColor"/></svg>';

  function progress() {
    const f = document.getElementById('lm-fill'); if (!f) return;
    const d = musicAudio.duration || 0, c = musicAudio.currentTime || 0;
    f.style.width = (d ? Math.min(100, c / d * 100) : 0) + '%';
    document.getElementById('lm-cur').textContent = fmtTime(c);
    document.getElementById('lm-rem').textContent = '-' + fmtTime(d - c);
  }

  function build() {
    const i = musicIdx >= 0 ? musicIdx : 0, t = musicTracks[i];
    const playing = !musicAudio.paused;
    box.innerHTML =
      '<div class="lm-top">' + musicArt(i, 46) +
        '<div class="lm-meta"><div class="lm-title">' + esc(t.title) + '</div><div class="lm-artist">' + esc(t.artist) + '</div></div>' +
        '<div class="lm-eq' + (playing ? ' on' : '') + '"><i></i><i></i><i></i><i></i></div></div>' +
      '<div class="lm-prog"><span id="lm-cur">0:00</span><div class="lm-bar"><b id="lm-fill"></b></div><span id="lm-rem">-0:00</span></div>' +
      '<div class="lm-ctl">' +
        '<button class="sm">' + star + '</button>' +
        '<button class="md" onclick="musicPrev()">' + mi.prev + '</button>' +
        '<button class="lg" onclick="musicToggle()">' + (playing ? mi.pause : mi.play) + '</button>' +
        '<button class="md" onclick="musicNext(false)">' + mi.next + '</button>' +
        '<button class="sm">' + air + '</button>' +
      '</div>';
    progress();
  }

  /* a primeira música já fica "tocando agora" na lockscreen */
  if (musicIdx < 0) {
    musicIdx = 0;
    musicAudio.src = musicTracks[0].src;
    if (typeof musicSetMedia === 'function') musicSetMedia();
  }
  ['play', 'pause', 'loadstart', 'emptied'].forEach(ev => musicAudio.addEventListener(ev, build));
  ['timeupdate', 'loadedmetadata', 'durationchange'].forEach(ev => musicAudio.addEventListener(ev, progress));
  build();

  if (AUTOPLAY) {
    let armed = true;
    const kick = () => { const p = musicAudio.play(); if (p && p.catch) p.catch(() => {}); };
    musicAudio.addEventListener('play', () => { armed = false; });
    kick();                                           // tenta já ao abrir; se bloquear, começa no primeiro toque
    document.addEventListener('pointerdown', e => {
      if (!armed) return;
      armed = false;
      if (e.target.closest && e.target.closest('#lock-music')) return;   // se o toque foi no player, o botão decide
      kick();
    }, true);
  }
})();
