/* =====================================================
   SONS — toque do teclado, desbloquear, ligação etc.
   Cada som pode vir de um arquivo seu (SOUND_FILES) ou, se o campo estiver vazio,
   de um som sintetizado pelo próprio navegador (sem precisar de arquivo).
   ===================================================== */
const SOUND_ON = true;                         // false desliga todos os sons
const SOUND_FILES = {                          // ex.: unlock: 'sounds/unlock.mp3'   ('' = som sintetizado)
  tap: '',          // toque numa tecla do código
  unlock: '',       // código certo / desbloqueou
  wrong: '',        // código errado
  lock: '',         // voltou para a tela de bloqueio
  click: '',        // lanterna ligar/desligar
  calling: '',      // chamando (quando VOCÊ liga)
  connected: '',    // chamada atendeu
  hangup: '',       // chamada terminou
  ring: '',         // chamada recebida (toca em loop até atender/recusar)
  message: ''       // notificação de mensagem (use snd('message') onde quiser)
};
const SOUND_VOL = { tap: .6, unlock: .8, wrong: .8, lock: .8, click: .6, calling: .8, connected: .8, hangup: .8, ring: 1, message: 1 };

(function () {
  let ctx = null, ringTimer = null;
  const files = {};                            // áudios de arquivo em andamento

  function ac() {
    if (!ctx) { const C = window.AudioContext || window.webkitAudioContext; if (!C) return null; ctx = new C(); }
    if (ctx.state === 'suspended') ctx.resume();
    return ctx;
  }
  /* libera o áudio no primeiro toque (os navegadores bloqueiam som antes disso) */
  ['pointerdown', 'keydown', 'touchstart'].forEach(ev => document.addEventListener(ev, ac, { once: true, capture: true }));

  /* uma nota: freq em Hz, t0 = atraso (s), dur = duração (s)
     pluck = true: decai rápido (toque/sino) · false: segura o volume e some no fim (tom de chamada) */
  function tone(freq, t0, dur, o) {
    const c = ac(); if (!c) return;
    o = o || {};
    const vol = (o.vol == null ? .2 : o.vol), at = c.currentTime + t0;
    const osc = c.createOscillator(), g = c.createGain();
    osc.type = o.type || 'sine';
    osc.frequency.setValueAtTime(freq, at);
    if (o.to) osc.frequency.exponentialRampToValueAtTime(o.to, at + dur);
    g.gain.setValueAtTime(0.0001, at);
    g.gain.exponentialRampToValueAtTime(vol, at + (o.attack || .004));
    if (o.pluck === false) { g.gain.setValueAtTime(vol, at + dur * .8); }
    g.gain.exponentialRampToValueAtTime(0.0001, at + dur);
    osc.connect(g); g.connect(c.destination);
    osc.start(at); osc.stop(at + dur + .03);
  }

  const synth = {
    tap:       v => { tone(1250, 0, .05, { vol: .16 * v }); tone(620, 0, .06, { vol: .1 * v }); },
    click:     v => { tone(1700, 0, .035, { type: 'square', vol: .05 * v }); },
    unlock:    v => { tone(740, 0, .09, { vol: .16 * v }); tone(1110, .08, .16, { vol: .16 * v }); },
    lock:      v => { tone(980, 0, .07, { vol: .15 * v }); tone(650, .07, .13, { vol: .15 * v }); },
    wrong:     v => { tone(210, 0, .13, { type: 'square', vol: .07 * v }); tone(210, .18, .13, { type: 'square', vol: .07 * v }); },
    message:   v => { tone(1319, 0, .38, { type: 'triangle', vol: .2 * v }); tone(1568, .13, .38, { type: 'triangle', vol: .2 * v }); tone(2093, .26, .55, { type: 'triangle', vol: .2 * v }); },
    connected: v => { tone(880, 0, .1, { vol: .14 * v }); tone(1175, .11, .16, { vol: .14 * v }); },
    hangup:    v => { tone(480, 0, .22, { vol: .12 * v, pluck: false }); tone(480, .3, .22, { vol: .12 * v, pluck: false }); },
    calling:   v => { tone(440, 0, 1.6, { vol: .07 * v, pluck: false }); tone(480, 0, 1.6, { vol: .07 * v, pluck: false }); },
    ring:      v => { for (let i = 0; i < 2; i++) { const t = i * .5; tone(880, t, .16, { type: 'triangle', vol: .12 * v, pluck: false }); tone(1175, t + .17, .16, { type: 'triangle', vol: .12 * v, pluck: false }); tone(880, t + .34, .12, { type: 'triangle', vol: .12 * v, pluck: false }); } }
  };

  window.snd = function (name) {
    if (!SOUND_ON) return;
    const vol = (SOUND_VOL[name] == null ? 1 : SOUND_VOL[name]);
    const loop = name === 'ring';
    try {
      if (SOUND_FILES[name]) {                                      // arquivo seu
        if (files[name]) { files[name].pause(); }
        const a = new Audio(SOUND_FILES[name]);
        a.volume = Math.min(1, vol); a.loop = loop;
        files[name] = a;
        const p = a.play(); if (p && p.catch) p.catch(() => {});
        return;
      }
      if (!synth[name]) return;                                      // som sintetizado
      if (loop) {
        clearInterval(ringTimer); synth.ring(vol);
        ringTimer = setInterval(() => synth.ring(vol), 2400);
      } else synth[name](vol);
    } catch (e) {}
  };
  window.sndStop = function (name) {
    if (name === 'ring') { clearInterval(ringTimer); ringTimer = null; }
    const a = files[name]; if (a) { a.pause(); a.currentTime = 0; delete files[name]; }
  };
})();


